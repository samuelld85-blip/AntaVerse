{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "label": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 4 },
    "icon": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["Culture générale accessible", "Pop culture & loisirs", "Vie quotidienne & société"]
    },
    "weight": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "subthemes": {
      "minItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 4 }
        },
        "required": ["id", "label", "description"],
        "additionalProperties": false
      }
    },
    "tags": {
      "minItems": 5,
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "contentVersion": { "type": "string", "minLength": 1 }
  },
  "required": [
    "id",
    "label",
    "description",
    "icon",
    "category",
    "weight",
    "subthemes",
    "tags",
    "contentVersion"
  ],
  "additionalProperties": false,
  "$id": "https://qui-des-9.local/schema/2026.08.17/theme.schema.json",
  "title": "Thème Qui des 9",
  "x-content-version": "2026.08.17"
}
