# No environment variable is required for local play, including the local Sport carnet.
# Sport accounts: use only the project's PUBLIC browser key, never a service_role secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# VAPID public key for browser push subscriptions (the private key stays in Edge secrets).
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
